PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/bulldogs_sms
# Long random string used to sign login sessions (recommended). If empty, a random one is made on each start.
SESSION_SECRET=change-this-to-a-long-random-string
# Used by `npm run seed` for the admin account
ADMIN_EMAIL=admin@national-u.edu.ph
ADMIN_PASSWORD=password123
